var stdout = native stdout()
var stdin = native stdin()
var stderr = native stderr()

var FILE_READ = 1
var FILE_WRITE = 2
var FILE_APP = 4
var FILE_BIN = 8


function open(file, mode) {
    return native open(file, mode)
}

function close(file) {
    native close(file)
}

function print(value) {
    write stdout, value
    flush stdout
}

function println(value) {
    write stdout, value
    write stdout, "\n"
    flush stdout
}

function printf(file, value) {
    write file, value
    flush file
}

function printfln(file, value) {
    write file, value
    write file, "\n"
    flush file
}

function printn(value) {
    write stdout, value
}

function printnf(file, value) {
    write file, value
}

function readln() {
    return read stdin
}

function readfln(file) {
    return read file
}

function flushf(file) {
    flush file
}